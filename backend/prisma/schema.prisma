// NST Buddy 2.0 - Multi-Campus Platform Schema
// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Campus Model - Delhi NCR, Pune, Bangalore
model Campus {
  id          String     @id @default(cuid())
  name        String     @unique // "Delhi NCR", "Pune", "Bangalore"
  slug        String     @unique // "delhi-ncr", "pune", "bangalore"
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([isActive])
}

// User Model - Enhanced with contribution tracking
model User {
  id                 String     @id @default(cuid())
  firebaseUid        String     @unique
  email              String     @unique
  name               String
  picture            String?
  isPro              Boolean    @default(false)
  isAdmin            Boolean    @default(false)
  isBanned           Boolean    @default(false) // blocked from creating community posts/comments

  // Academic-integrity disclaimer acknowledgement (re-prompted every 7 days)
  disclaimerAcknowledgedAt DateTime?

  // Contribution stats
  contributionCount  Int        @default(0)
  contributionPoints Int        @default(0)

  questions          Question[]
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  groupsCreated      Group[]       @relation("GroupCreator")
  groupMemberships   GroupMember[]
  lastLoginAt        DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([email])
  @@index([firebaseUid])
  @@index([contributionPoints])
}

// Group - a bounded-capacity team students can create and join (e.g. for a hackathon)
model Group {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String? // e.g. "Hackathon", "Study Group", "Project"
  bannerUrl   String? // optional ImageKit CDN URL for the group's cover image
  capacity    Int      // total member cap, including the creator
  isActive    Boolean  @default(true) // false = closed to new joins, but existing members/history stay

  creatorEmail String
  creator      User    @relation("GroupCreator", fields: [creatorEmail], references: [email], onDelete: Cascade)

  members     GroupMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorEmail])
  @@index([isActive])
}

// GroupMember - join record; carries the contact info a member shares so the
// group admin can reach out (per-group, since a student may not want the same
// number visible to every group they're in).
model GroupMember {
  id            String   @id @default(cuid())

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String

  memberEmail   String
  member        User     @relation(fields: [memberEmail], references: [email], onDelete: Cascade)

  contactMethod String   // 'phone' | 'whatsapp' | 'email'
  contactValue  String

  role          String   @default("member") // 'admin' | 'member' - creator is seeded as 'admin'

  joinedAt      DateTime @default(now())

  @@unique([groupId, memberEmail])
  @@index([groupId])
  @@index([memberEmail])
}

// Community Post - Twitter-style feed post
model Post {
  id          String    @id @default(cuid())
  content     String
  images      String[]  @default([]) // ImageKit CDN URLs, max 5 enforced in the route

  authorEmail String
  author      User      @relation(fields: [authorEmail], references: [email], onDelete: Cascade)

  likes       Like[]
  comments    Comment[]
  hashtags    PostHashtag[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorEmail])
  @@index([createdAt])
}

// Hashtag - normalized tag extracted from Post content, tracks trending count
model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique // lowercase, without the '#'
  postCount Int           @default(0)
  posts     PostHashtag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postCount])
}

// Join table linking Posts to Hashtags
model PostHashtag {
  id        String  @id @default(cuid())

  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  hashtagId String

  @@unique([postId, hashtagId])
  @@index([postId])
  @@index([hashtagId])
}

// Community Comment - a reply on a Post
model Comment {
  id          String   @id @default(cuid())
  content     String

  authorEmail String
  author      User     @relation(fields: [authorEmail], references: [email], onDelete: Cascade)

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId])
  @@index([authorEmail])
}

// Like on a community Post - one per user per post
model Like {
  id        String   @id @default(cuid())

  userEmail String
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  createdAt DateTime @default(now())

  @@unique([userEmail, postId])
  @@index([postId])
}

// Question Model - Multi-campus with contributor tracking
model Question {
  id               String   @id @default(cuid())
  questionName     String
  subject          String
  topic            String
  link             String
  semester         Int?     // 1-8, only set for the College flow

  // Campus relation - only set for the College flow
  campus           Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  campusId         String?

  // Free-text course name for the "Others" contribution flow (no campus/semester)
  customCourse     String?

  // Contributor tracking
  contributorEmail String
  contributor      User     @relation(fields: [contributorEmail], references: [email], onDelete: Cascade)

  // Admin approval workflow
  isApproved       Boolean  @default(true) // Auto-approve for now
  approvedBy       String?
  approvedAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campusId, semester])
  @@index([customCourse])
  @@index([contributorEmail])
  @@index([subject])
  @@index([topic])
  @@index([isApproved])
}

// Notice Model - Unchanged
model Notice {
  id        String    @id @default(cuid())
  title     String
  content   String
  priority  String    @default("normal") // low, normal, high
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([isActive])
  @@index([priority])
}

// Admin Model - Keep for backward compatibility (will be deprecated)
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  uniqueKey String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CustomCourse - admin-defined course names for the "Others" contribution flow.
// Students pick from this list; only admins can add new entries.
model CustomCourse {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String? // ImageKit CDN URL, shown on the homepage course card
  createdBy   String
  createdAt   DateTime @default(now())
}
